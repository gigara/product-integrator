+export class Wso2ComponentUpdateService extends Disposable implements IWso2ComponentUpdateService {
+
+	declare readonly _serviceBrand: undefined;
+
+	private readonly _onStateChange = this._register(new Emitter<Wso2UpdateState>());
+	readonly onStateChange = this._onStateChange.event;
+
+	private _state: Wso2UpdateState = { type: Wso2UpdateStateType.Idle };
+	async getState(): Promise<Wso2UpdateState> { return this._state; }
+	private setState(state: Wso2UpdateState): void {
+		this._state = state;
+		this._onStateChange.fire(state);
+	}
+
+	/** The last verified manifest, retained so downloadUpdates() can act on the offered set. */
+	private lastManifest: IWso2UpdateManifest | undefined;
+
+	constructor(
+		@ILifecycleMainService private readonly lifecycleMainService: ILifecycleMainService,
+		@IConfigurationService private readonly configurationService: IConfigurationService,
+		@IRequestService private readonly requestService: IRequestService,
+		@ILogService private readonly logService: ILogService,
+		@IProductService private readonly productService: IProductService
+	) {
+		super();
+
+		// Reconcile bundled-vs-override state once (a freshly installed full app may
+		// have superseded earlier overrides). Runtime activation itself happens earlier,
+		// in the bootstrap, before any window or extension host exists.
+		try {
+			reconcileBundledVersions(this.componentsHome, this.productService.bundledComponents, msg => this.logService.trace(`[wso2Update] ${msg}`));
+		} catch (err) {
+			this.logService.warn('[wso2Update] reconcile failed', err);
+		}
+
+		// We reached construction, so the app booted successfully with whatever overrides are
+		// active — mark freshly activated runtimes healthy and garbage-collect stale versions.
+		try {
+			this.markHealthyAndGarbageCollect();
+		} catch (err) {
+			this.logService.warn('[wso2Update] health/GC pass failed', err);
+		}
+
+		if (!this.updateBaseUrl) {
+			this.logService.info('[wso2Update] disabled (no wso2UpdateUrl configured)');
+			return;
+		}
