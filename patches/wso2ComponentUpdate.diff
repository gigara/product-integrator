+/**
+ * Renders the title-bar update indicator as a prominent (blue) button, matching
+ * the built-in VS Code update indicator. Clicking runs the indicator action.
+ */
+class Wso2UpdateIndicatorViewItem extends BaseActionViewItem {
+	constructor(action: IAction, options: IBaseActionViewItemOptions) {
+		super(undefined, action, options);
+	}
+
+	override render(container: HTMLElement): void {
