+			await applyAppUpdate(updateService, dialogService, notificationService, state.appUpdate.version);
+		}
+	}
+}
+
+interface IComponentPickItem extends IQuickPickItem {
+	readonly componentId: string;
+	readonly kind: string;
+	readonly updatable: boolean;
+	readonly pending: boolean;
+}
+
+class ShowComponentsAction extends Action2 {
+	constructor() {
+		super({
+			id: 'wso2.updates.showComponents',
+			title: localize2('wso2.updates.showComponents', "Show Components"),
+			category: CATEGORY,
+			f1: true
+		});
+	}
+	async run(accessor: ServicesAccessor): Promise<void> {
+		const updateService = accessor.get(IWso2ComponentUpdateService);
+		const quickInputService = accessor.get(IQuickInputService);
+		const notificationService = accessor.get(INotificationService);
+		const hostService = accessor.get(IHostService);
+		const statuses = await updateService.getComponentStatuses();
+		const items: IComponentPickItem[] = statuses.map(s => {
+			const updatable = !!s.availableVersion;
+			const pending = !!s.pendingVersion;
+			// Show the running version (+ an "updated" hint when it differs from what shipped) and
+			// what's actionable. The bundled version isn't shown on its own anymore — with revert
+			// gone it was only the reset target; it's still used internally as the update floor.
+			const currentVersion = s.activeVersion ?? s.bundledVersion ?? '—';
+			const isUpdated = !!(s.activeVersion && s.bundledVersion && s.activeVersion !== s.bundledVersion);
+			const detailParts = [
+				isUpdated
+					? localize('wso2.updates.currentUpdated', "current {0} (updated)", currentVersion)
+					: localize('wso2.updates.current', "current {0}", currentVersion),
+				s.availableVersion ? localize('wso2.updates.availableItem', "available {0}", s.availableVersion) : undefined,
+				s.pendingVersion ? localize('wso2.updates.pending', "pending restart {0}", s.pendingVersion) : undefined
+			].filter(Boolean);
+			const icon = updatable ? '$(cloud-download) ' : (pending ? '$(sync) ' : '');
+			return {
+				label: `${icon}${s.id}`,
+				description: `(${s.kind})`,
+				detail: detailParts.join('  ·  '),
+				componentId: s.id,
+				kind: s.kind,
+				updatable,
+				pending
+			};
+		});
+		const anyActionable = items.some(i => i.updatable || i.pending);
+		const picked = await quickInputService.pick(items, {
+			placeHolder: anyActionable
+				? localize('wso2.updates.componentsPlaceholderUpdatable', "Select a component to update or restart; Esc to close")
+				: localize('wso2.updates.componentsPlaceholder', "Installed WSO2 Integrator components")
+		});
+		if (!picked) {
+			return;
+		}
+		if (picked.updatable) {
+			await updateService.downloadUpdates([picked.componentId]);
+		} else if (picked.pending) {
+			notificationService.prompt(Severity.Info, localize('wso2.updates.componentPending', "{0} is downloaded. Restart WSO2 Integrator to finish updating.", picked.componentId), [
+				{ label: localize('wso2.updates.restartNow', "Restart"), run: () => hostService.restart() }
+			]);
+		} else {
+			notificationService.info(localize('wso2.updates.componentUpToDate', "{0} is already up to date.", picked.componentId));
+		}
+	}
+}
+
+class UpdateIndicatorAction extends Action2 {
+	constructor() {
+		super({
+			id: 'wso2.updates.titleBarIndicator',
+			title: localize2('wso2.updates.titleBarIndicator', "Update WSO2 Integrator Components"),
+			icon: Codicon.cloudDownload,
+			f1: false,
+			menu: [{
+				id: MenuId.TitleBarAdjacentCenter,
+				order: 0,
+				when: ContextKeyExpr.and(ContextKeyExpr.has(WSO2_UPDATES_AVAILABLE_KEY), ContextKeyExpr.notEquals('config.wso2.updates.titleBar', false))
+			}]
+		});
+	}
+	run(accessor: ServicesAccessor): Promise<unknown> {
+		return accessor.get(ICommandService).executeCommand('wso2.updates.applyAll');
+	}
+}
+
+registerAction2(CheckForUpdatesAction);
+registerAction2(UpdateAllAction);
+registerAction2(ShowComponentsAction);
+registerAction2(UpdateIndicatorAction);
