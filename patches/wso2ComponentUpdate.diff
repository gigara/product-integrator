+		dom.append(indicator, dom.$(ThemeIcon.asCSSSelector(Codicon.cloudDownload)));
+		const label = dom.append(indicator, dom.$('.indicator-label'));
+		label.textContent = localize('wso2.updates.updateLabel', "Update");
+	}
+}
